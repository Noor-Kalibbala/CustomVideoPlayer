#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<BasePlayerButton>:
    theme_icon_color: "Custom"
    icon_color: "white"
    theme_font_size: "Custom"
    font_size: sp(20)

<ProgressBarVideo>:
    canvas:
        # Inactive track.
        Color:
            rgba: self.track_color
        Rectangle:
            pos: self.x, self.center_y - self.bar_height / 2
            size: self.width, self.bar_height
        # Hover preview: lighter fill up to the cursor.
        Color:
            rgba: 1, 1, 1, (.35 if self.hovered and not self.dragging else 0)
        Rectangle:
            pos: self.x, self.center_y - self.bar_height / 2
            size: self.width * self.hover_value, self.bar_height
        # Played part.
        Color:
            rgba: self.indicator_color
        Rectangle:
            pos: self.x, self.center_y - self.bar_height / 2
            size: self.width * self.value_normalized, self.bar_height
        # Scrub handle, visible on hover / drag.
        Color:
            rgba: self.indicator_color[:3] + [1 if (self.hovered or self.dragging) else 0]
        Ellipse:
            pos: self.x + self.width * self.value_normalized - dp(7), self.center_y - dp(7)
            size: dp(14), dp(14)

    # Time under the cursor.
    Label:
        text: root.hover_text
        font_size: sp(12)
        size_hint: None, None
        size: self.texture_size[0] + dp(12), self.texture_size[1] + dp(6)
        center_x: min(max(root.x + root.width * root.hover_value, root.x + self.width / 2), root.right - self.width / 2)
        y: root.top + dp(4)
        opacity: 1 if (root.hovered or root.dragging) and root.hover_text else 0
        canvas.before:
            Color:
                rgba: 0, 0, 0, .8
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(4)]

# Control bar, overlaid on the bottom of the video.
<PlayerButtonBox>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(12), dp(32), dp(12), dp(4)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: self.gradient_texture

    ProgressBarVideo:
        id: progress_bar
        video: root.video
        size_hint_y: None
        height: dp(20)  # generous hit area; the bar itself is drawn 4-6dp tall
        indicator_color: app.theme_cls.primaryColor

    MDBoxLayout:
        adaptive_height: True
        spacing: dp(4)

        ButtonVideoPlayPause:
            id: btn_play_pause
            video: root.video
            icon: "play"  # kept in sync from PlayerButtonBox._sync_with_video

        ButtonVideoStop:
            id: btn_stop
            video: root.video
            icon: "stop"

        ButtonVideoVolume:
            id: btn_volume
            video: root.video
            icon: "volume-high"

        MDRelativeLayout:
            id: volume_container
            size_hint: None, None
            size: root.width * .2, dp(40)

            MDSlider:
                id: volume_slider
                size_hint_y: None
                height: dp(32)
                pos_hint: {"center_y": .5}
                max: 100
                value: 100
                on_value: if root.video: root.video.volume = self.value / 100
                MDSliderHandle:

        MDLabel:
            id: time
            text: "0:00"
            adaptive_width: True
            size_hint_y: None
            height: dp(40)
            padding: dp(8), 0
            theme_text_color: "Custom"
            text_color: "white"
            font_style: "Body"
            role: "small"

        Widget:  # spacer pushing the full-screen button to the right
            size_hint_y: None
            height: dp(1)

        ButtonVideoFullScreen:
            id: btn_full_screen
            video: root.video
            icon: "fullscreen"


# Replaces only CustomVideoPlayer's inherited rule (the old `<-VideoPlayer>`
# also replaced the rule of every plain Kivy VideoPlayer in the app).
<-CustomVideoPlayer>:
    container: container
    cols: 1
    allow_fullscreen: False

    MDFloatLayout:
        id: stage

        PlayerContainer:
            id: container
            md_bg_color: "black"
            pos_hint: {"x": 0, "y": 0}

        # Big play/pause icon in the middle.
        MDIcon:
            id: center_icon
            icon: "play"
            theme_font_size: "Custom"
            font_size: sp(44)
            theme_text_color: "Custom"
            text_color: "white"
            size_hint: None, None
            size: dp(80), dp(80)
            halign: "center"
            valign: "center"
            pos_hint: {"center_x": .5, "center_y": .5}
            canvas.before:
                Color:
                    rgba: 0, 0, 0, .45
                Ellipse:
                    pos: self.pos
                    size: self.size

        PlayerButtonBox:
            id: button_box
            video: root
            pos_hint: {"x": 0, "y": 0}
